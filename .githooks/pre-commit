#!/usr/bin/env bash
set -Eeuo pipefail

REPO="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO"
source "$REPO/tools/lib.sh"
require_bash 4.4

if ! command -v gitleaks >/dev/null 2>&1; then
	die "gitleaks is required for the staged secret scan; install it and retry"
fi

gitleaks protect --staged --redact --config .gitleaks.toml --exit-code 1
log_line SUCCESS "staged secret scan"
